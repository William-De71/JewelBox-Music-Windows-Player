{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JewelBox Music Player",
  "mainBinaryName": "JewelBox",
  "version": "../package.json",
  "identifier": "io.github.william-de71.jewelbox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JewelBox Music Player",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=HardwareMediaKeyHandling --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http: https:; media-src 'self' http: https: blob:; connect-src 'self' ipc: http://ipc.localhost http: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "William Deren",
    "copyright": "© William Deren — MIT",
    "category": "Music",
    "shortDescription": "Client de streaming pour le serveur JewelBox Music Library",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
